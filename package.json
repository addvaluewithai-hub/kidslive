{
  "name": "kidslive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format:check": "node scripts/check-style.mjs",
    "lint": "pnpm check:boundaries && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "e2e": "playwright test",
    "ci": "pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm e2e",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "phaser": "3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "1.55.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.0.1"
  }
}
