; KidsLive architecture shootout — native Godot candidate
; Everything in this benchmark is authored as text/code and can run headless in CI.

config_version=5

[application]
config/name="KidsLive Godot Benchmark"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1

environment/defaults/default_clear_color=Color(0.031, 0.043, 0.133, 1)
